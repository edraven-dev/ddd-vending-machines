<%_ const images = buildable_projects.filter((p) => p.id !== 'frontend') -%>
version: 2.1

orbs:
  node: circleci/node@7.2.1<% if ((branch === 'master' || branch === 'develop') && buildable_projects.some((p) => p.id === 'frontend')) { %>
  aws-cli: circleci/aws-cli@5.4.3<% } %>

defaults: &defaults
  resource_class: small
  docker:
    - image: cimg/node:<%= node_version %>

commands:
  checkout_and_install:
    steps:
      - checkout
      - run:
          name: Install pnpm
          command: sudo npm install -g "$(node -p "require('./package.json').packageManager")"
      - node/install-packages:
          pkg-manager: pnpm<%
  if (branch === 'master' || branch === 'develop') {
  %>
  setup-buildx:
    steps:
      - checkout
      - run:
          name: Setup buildx and qemu
          command: |
            sudo apt-get update
            sudo apt-get install -y qemu-user-static binfmt-support
      - run:
          name: Check versions
          command: |
            qemu-aarch64-static --version
            update-binfmts --version
      - run:
          name: Create builder
          command: |
            export REPO_ORG=$(echo $CIRCLE_PROJECT_USERNAME | tr '[:upper:]' '[:lower:]')
            docker run --rm --privileged multiarch/qemu-user-static --reset -p yes
            docker run --privileged --rm tonistiigi/binfmt --install arm64
            docker buildx create --name multiarch-builder
            docker buildx use multiarch-builder
            docker buildx inspect --bootstrap <% } %>
jobs:
  format-check:
    <<: *defaults
    steps:
      - checkout_and_install
      - run:
          name: Check formatting
          command: pnpm format:check
  <% for (let i = 0; i < buildable_projects.length; i++) { %>
  build-<%= buildable_projects[i].id %>:
    <<: *defaults
    <% Object.entries(parameters[buildable_projects[i].id]?.build || {}).forEach(([key, value]) => { %><%= key %>: <%= value %>
    <% }); %>
    steps:
      - checkout_and_install
      - run:
          name: Build <%= buildable_projects[i].id %>
          command: pnpm turbo run build --filter=<%= buildable_projects[i].name %>
  <% } %><% for (let i = 0; i < lintable_projects.length; i++) { %>
  lint-<%= lintable_projects[i].id %>:
    <<: *defaults
    <% Object.entries(parameters[lintable_projects[i].id]?.lint || {}).forEach(([key, value]) => { %><%= key %>: <%= value %>
    <% }); %>
    steps:
      - checkout_and_install
      - run:
          name: Lint <%= lintable_projects[i].id %>
          # migration:check (Nest apps only) compares the entities with the committed snapshot: no database needed
          command: pnpm turbo run lint typecheck migration:check --filter=<%= lintable_projects[i].name %>
  <% } %><% for (let i = 0; i < testable_projects.length; i++) { %>
  test-<%= testable_projects[i].id %>:
    <<: *defaults
    <% Object.entries(parameters[testable_projects[i].id]?.test || {}).forEach(([key, value]) => { %><%= key %>: <%= value %>
    <% }); %>
    steps:
      - checkout_and_install
      - run:
          name: Test <%= testable_projects[i].id %>
          command: pnpm turbo run test:ci --filter=<%= testable_projects[i].name %>
      - store_test_results:
          path: <%= testable_projects[i].dir %>/test-results
      - store_artifacts:
          path: <%= testable_projects[i].dir %>/coverage
  <% } %><% if (branch === 'develop' || branch === 'master') {  for (let i = 0; i < buildable_projects.length; i++) { if (buildable_projects[i].id !== 'frontend') { %>
  build-and-push-docker-image-<%= buildable_projects[i].id %><%= branch === 'develop' ? '-dev': '' %>:
    docker:
      - image: cimg/base:current
    resource_class: medium+
    steps:
      - checkout
      - setup_remote_docker:
          docker_layer_caching: true
      - setup-buildx
      - run:
          name: Build Docker image for <%= buildable_projects[i].id %> and push to GHCR
          command: |
            export BUILDX_NO_DEFAULT_ATTESTATIONS=1
            export REPO_ORG=$(echo $CIRCLE_PROJECT_USERNAME | tr '[:upper:]' '[:lower:]')
            echo $GH_TOKEN | docker login ghcr.io --username $GH_USERNAME --password-stdin
            docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/$REPO_ORG/$CIRCLE_PROJECT_REPONAME/<%= buildable_projects[i].id %>:$CIRCLE_SHA1 -t ghcr.io/$REPO_ORG/$CIRCLE_PROJECT_REPONAME/<%= buildable_projects[i].id %>:<%= branch === "master" ? "latest" : "dev" %> --build-arg="APP=<%= buildable_projects[i].name %>" --build-arg="NODE_VERSION=<%= node_version %>" --push .
  <% } else { %>build-and-upload-frontend-files:
    <<: *defaults
    <% Object.entries(parameters['frontend']?.test || {}).forEach(([key, value]) => { %><%= key %>: <%= value %>
    <% }); %>executor: aws-cli/default
    steps:
      - checkout_and_install
      - aws-cli/setup
      - run:
          name: Build frontend and upload
          command: |
            pnpm turbo run build --filter=frontend
            aws s3 rm s3://ddd-vending-machines<%= branch === 'master' ? '-prod' : '-dev' %>/ --recursive --endpoint-url=$AWS_ENDPOINT_URL
            aws s3 cp ./apps/frontend/build s3://ddd-vending-machines<%= branch === 'master' ? '-prod' : '-dev' %>/ --recursive --endpoint-url=$AWS_ENDPOINT_URL
    <% }}} if ((branch === 'develop' || branch === 'master') && buildable_projects.length) { %>
  push-git-tag:
    <<: *defaults
    steps:
      - checkout
      - run:
          name: Push git tag
          command: |
            git config user.email $GH_EMAIL
            git config user.name $GH_USERNAME
            git tag -a release<%= branch === 'master' ? '' : '-dev' %>-<< pipeline.number >> -m "Release <%= branch === 'master' ? '' : 'dev ' %>CircleCI build nr #<< pipeline.number >>"
            git push "https://${GH_TOKEN}@github.com/${CIRCLE_PROJECT_USERNAME}/${CIRCLE_PROJECT_REPONAME}.git" release<%= branch === 'master' ? '' : '-dev' %>-<< pipeline.number >>
  <% } if ((branch === 'develop' || branch === 'master') && images.length) { %>
  push-tags-to-k8s-manifests:
    <<: *defaults
    steps:
      - run:
          name: Push image tags in k8s manifests
          command: |
            export REPO_ORG=$(echo $CIRCLE_PROJECT_USERNAME | tr '[:upper:]' '[:lower:]')
            git clone $K8S_REPOSITORY_URL .
            git config user.email $GH_EMAIL
            git config user.name $GH_USERNAME
            git config url.https://${GH_TOKEN}@github.com/.insteadOf https://github.com/
            <% images.forEach((p) => { %>find ./<%= branch === 'master' ? 'prod' : 'dev' %> -type f -exec sed -i -E "s|(image: ghcr.io/${REPO_ORG}/${CIRCLE_PROJECT_REPONAME}/<%= p.id %>:).*|\1${CIRCLE_SHA1}|g" {} \;
            <% }) %>git add .
            git commit -m "Update image tags in k8s manifests for CircleCI build nr #<< pipeline.number >>"
            git push origin master
  <% } %>
workflows:
  build-lint-test<%= branch === 'develop' || branch === 'master' ? '-deploy' : '' %>:
    jobs:
      <% for (let i = 0; i < buildable_projects.length; i++) { %>- build-<%= buildable_projects[i].id %>
      <% } %>
      <% for (let i = 0; i < lintable_projects.length; i++) { %>- lint-<%= lintable_projects[i].id %>
      <% } %>
      <% for (let i = 0; i < testable_projects.length; i++) { %>- test-<%= testable_projects[i].id %>
      <% } %>- format-check
      <% if (branch === 'develop' || branch === 'master') { %>- hold:
          type: approval
          requires:
            - format-check
            <% for (let i = 0; i < buildable_projects.length; i++) { %>- build-<%= buildable_projects[i].id %>
            <% } %><% for (let i = 0; i < lintable_projects.length; i++) { %>- lint-<%= lintable_projects[i].id %>
            <% } %><% for (let i = 0; i < testable_projects.length; i++) { %>- test-<%= testable_projects[i].id %>
            <% }} %>
      <% if (branch === 'develop' || branch === 'master') { for (let i = 0; i < buildable_projects.length; i++) { if (buildable_projects[i].id !== 'frontend') { %>- build-and-push-docker-image-<%= buildable_projects[i].id %><%= branch === 'master' ? '': '-dev' %>:
          requires:
            - hold
      <% } else { %>- build-and-upload-frontend-files:
          requires:
            - hold
      <% }}} %><% if ((branch === 'develop' || branch === 'master') && buildable_projects.length) { %>- push-git-tag:
          requires:
            <% for (let i = 0; i < buildable_projects.length; i++) { if (buildable_projects[i].id !== 'frontend') { %>- build-and-push-docker-image-<%= buildable_projects[i].id %><%= branch === 'master' ? '': '-dev' %>
            <% } else { %>- build-and-upload-frontend-files
            <% }}} %>
      <% if ((branch === 'develop' || branch === 'master') && images.length) { %>- push-tags-to-k8s-manifests:
          requires:
            - push-git-tag<% } %>