{
  // $app/tsconfig is generated by `svelte-kit sync` (node_modules/$app/tsconfig.json) and already sets
  // the essential and recommended options (verbatimModuleSyntax, isolatedModules, moduleResolution bundler, ...)
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    // Overriding "types" replaces the inherited array, so it must keep "$app/types"
    "types": ["$app/types", "vitest/globals"]
  },
  "include": ["src", "*"],
  "exclude": ["src/service-worker"]
}
