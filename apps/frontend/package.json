{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "lint": "svelte-kit sync && oxlint -c ../../.oxlintrc.json --type-aware",
    "typecheck": "svelte-kit sync && svelte-check --fail-on-warnings",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=./test-results/test-results.xml"
  },
  "devDependencies": {
    "@iconify/svelte": "5.2.4",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitest/coverage-v8": "catalog:",
    "@zerodevx/svelte-toast": "0.9.6",
    "axios": "1.21.1",
    "currency.js": "catalog:",
    "jsdom": "31.0.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
