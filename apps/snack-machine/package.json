{
  "name": "snack-machine",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "webpack -c webpack.config.cjs --mode production",
    "dev": "webpack -c webpack.config.cjs --mode development --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --ci --coverage",
    "migration:create": "mikro-orm migration:create -b -n",
    "migration:generate": "mikro-orm migration:create -n",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:list": "mikro-orm migration:list",
    "migration:check": "mikro-orm migration:check",
    "migration:pending": "mikro-orm migration:pending",
    "migration:fresh": "mikro-orm migration:fresh"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm-cli.config.ts"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "1.13.4",
    "@grpc/proto-loader": "0.8.0",
    "@mikro-orm/core": "6.5.1",
    "@mikro-orm/migrations": "6.5.1",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.5.1",
    "@mikro-orm/seeder": "6.5.1",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/microservices": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@vending-machines/events": "workspace:*",
    "@vending-machines/proto": "workspace:*",
    "@vending-machines/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "currency.js": "2.0.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.5.1",
    "@nestjs/testing": "11.1.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4"
  }
}
