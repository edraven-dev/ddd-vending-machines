{
  "name": "event-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.mjs",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run e2e-spec",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=./test-results/test-results.xml",
    "migration:create": "mikro-orm migration:create -b -n",
    "migration:generate": "mikro-orm migration:create -n",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:list": "mikro-orm migration:list",
    "migration:check": "mikro-orm migration:check",
    "migration:pending": "mikro-orm migration:pending",
    "migration:fresh": "mikro-orm migration:fresh"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm-cli.config.ts"
    ],
    "tsLoader": "oxc"
  },
  "dependencies": {
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/decorators": "catalog:",
    "@mikro-orm/migrations": "catalog:",
    "@mikro-orm/nestjs": "catalog:",
    "@mikro-orm/postgresql": "catalog:",
    "@mikro-orm/seeder": "catalog:",
    "@mikro-orm/sql-highlighter": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@vending-machines/events": "workspace:*",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:",
    "ejson": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@mikro-orm/cli": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@oxc-node/core": "catalog:",
    "@types/ejson": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
