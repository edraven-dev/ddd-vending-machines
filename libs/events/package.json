{
  "name": "@vending-machines/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./amqp": "./src/amqp.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware",
    "typecheck": "tsc --noEmit",
