{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "globalDependencies": [
    ".nvmrc",
    ".dockerignore",
    ".oxlintrc.json",
    "Dockerfile",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    ".circleci/**",
    "tools/**"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "test:ci": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "frontend#test": {
      "dependsOn": ["transit", "build"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "frontend#test:ci": {
      "dependsOn": ["transit", "build"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
